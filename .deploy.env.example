# Copy this file to .deploy.env and edit the values.
# .deploy.env is ignored by Git.

BASE_URL=http://47.93.123.112/

# Prefer a dedicated deployment account. A temporary root fallback is supported
# by the script but should not be kept as the long-term configuration.
DEPLOY_USER=blogdeploy
DEPLOY_HOST=47.93.123.112
DEPLOY_PATH=/var/www/blog

# Optional. Leave empty to use ~/.ssh/config or ssh-agent.
# Git Bash example: /path/to/your/deploy_key
SSH_KEY=
SSH_PORT=22

# Optional SSH config alias. When set, it overrides DEPLOY_USER@DEPLOY_HOST.
# DEPLOY_TARGET=xuanwo-blog

